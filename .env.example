# KIS API credentials
KIS_APP_KEY="발급받은_앱키"
KIS_APP_SECRET="발급받은_앱시크릿"
KIS_ACCOUNT_TYPE="VIRTUAL"  # REAL 또는 VIRTUAL
KIS_CANO="계좌번호_앞8자리"
KIS_ACNT_PRDT_CD="01"


# Trading safety gate. Leave false for read-only use.
# Set true only when you intentionally want order/modify/cancel API calls enabled.
KIS_ENABLE_TRADING="false"

# Optional token cache path
KIS_TOKEN_FILE="token.json"

# MCP runtime. stdio is recommended for local MCP clients.
MCP_TYPE="stdio"  # stdio, sse, streamable-http
MCP_HOST="127.0.0.1"
MCP_PORT="8000"
MCP_PATH="/mcp"
